---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../lib/categories';

interface Props {
  articles: CollectionEntry<'articles'>[];
}
const { articles } = Astro.props;
---
<section class="z z--hero" id="hero">
  <div class="kj-icon kj-icon--1" aria-hidden="true"><img src="/img/kurage-icon.png" alt=""></div>

  <div class="hero-brand">
    <h1 class="hero-brand__title">KURAGE</h1>
    <p class="hero-brand__sub">海月舎</p>
    <p class="hero-brand__desc">骨のない文章が、いちばん深い。</p>
    <p class="hero-brand__msg">AIではなく、人間が書いた文章で、熱狂を。</p>
  </div>

  <div class="hero-carousel">
    <div class="hero-carousel__track">
      {articles.map((article, i) => {
        const cat = CATEGORIES[article.data.category];
        return (
          <a href={`/articles/${article.slug}`} class={`hero-slide ${i === 0 ? 'is-active' : ''}`}>
            <div class="hero-slide__img">
              {article.data.coverImage ? (
                <img src={article.data.coverImage} alt={article.data.title} style="width:100%;height:100%;object-fit:cover;">
              ) : (
                <div class="hero-slide__placeholder"><img src="/img/kurage-icon.png" alt="" class="hero-slide__deco"></div>
              )}
            </div>
            <div class="hero-slide__overlay">
              <span class="hero-slide__cat">{cat.ja}</span>
              <h2 class="hero-slide__title">{article.data.title}</h2>
              <p class="hero-slide__meta">{article.data.author} ・ {article.data.readingMinutes}分</p>
            </div>
          </a>
        );
      })}
    </div>
    <button class="hero-carousel__prev" aria-label="前へ">&larr;</button>
    <button class="hero-carousel__next" aria-label="次へ">&rarr;</button>
    <div class="hero-carousel__dots">
      {articles.map((_, i) => (
        <span class={`hero-carousel__dot ${i === 0 ? 'is-active' : ''}`}></span>
      ))}
    </div>
  </div>
</section>
