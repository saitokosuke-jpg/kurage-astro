---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES } from '../lib/categories';

interface SeriesSlide {
  series: CollectionEntry<'series'>;
  publishedEpisodes: number;
  latestEpisodeTitle?: string;
}

interface Props {
  seriesSlides: SeriesSlide[];
}
const { seriesSlides } = Astro.props;
---
<section class="z z--hero" id="hero">
  <div class="kj-icon kj-icon--1" aria-hidden="true"><img src="/img/kurage-icon.png" alt=""></div>

  <div class="hero-brand">
    <h1 class="hero-brand__title">KURAGE</h1>
    <p class="hero-brand__sub">海月舎</p>
    <p class="hero-brand__desc">何もかも投げ出して、ただひたすらに文章を読みたくなった。<br>そんな人のためのウェブマガジンです。</p>
  </div>

  <div class="hero-carousel">
    <div class="hero-carousel__track">
      {seriesSlides.map((item, i) => {
        const cat = CATEGORIES[item.series.data.category];
        const progress = Math.round((item.publishedEpisodes / item.series.data.totalEpisodes) * 100);
        return (
          <a href={`/series/${item.series.slug}`} class={`hero-slide ${i === 0 ? 'is-active' : ''}`}>
            <div class="hero-slide__img">
              {item.series.data.coverImage ? (
                <img src={item.series.data.coverImage} alt={item.series.data.title} style="width:100%;height:100%;object-fit:cover;">
              ) : (
                <div class="hero-slide__placeholder"><img src="/img/kurage-icon.png" alt="" class="hero-slide__deco"></div>
              )}
            </div>
            <div class="hero-slide__overlay">
              <div class="hero-slide__badge-row">
                <span class="hero-slide__cat">{cat.ja}連載</span>
                <span class="hero-slide__ep">第{item.publishedEpisodes}話 / 全{item.series.data.totalEpisodes}話</span>
              </div>
              <h2 class="hero-slide__title">{item.series.data.title}</h2>
              {item.series.data.description && (
                <p class="hero-slide__desc">{item.series.data.description}</p>
              )}
              <div class="hero-slide__bottom">
                <span class="hero-slide__author">{item.series.data.author}</span>
                <div class="hero-slide__progress">
                  <div class="hero-slide__progress-bar">
                    <div class="hero-slide__progress-fill" style={`width:${progress}%;background:${cat.color}`}></div>
                  </div>
                  <span class="hero-slide__progress-text">{progress}%</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
    <button class="hero-carousel__prev" aria-label="前へ">&#8592;</button>
    <button class="hero-carousel__next" aria-label="次へ">&#8594;</button>
    <div class="hero-carousel__dots">
      {seriesSlides.map((_, i) => (
        <span class={`hero-carousel__dot ${i === 0 ? 'is-active' : ''}`}></span>
      ))}
    </div>
  </div>
</section>
