---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import KurageIndex from '../components/KurageIndex.astro';
import SectionHead from '../components/SectionHead.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import RankItem from '../components/RankItem.astro';
import StaffCard from '../components/StaffCard.astro';
import AboutSection from '../components/AboutSection.astro';
import JellyfishSvg from '../components/JellyfishSvg.astro';

import { getCollection } from 'astro:content';
import { CATEGORIES, type CategoryKey } from '../lib/categories';

// 全記事取得（非公開除外）
const allArticles = (await getCollection('articles'))
  .filter(a => !a.data.draft);

// 連載データ（ヒーローカルーセル用）
const allSeries = await getCollection('series');
const seriesData = allSeries.map(s => {
  const episodes = allArticles.filter(a => a.data.series === s.slug);
  const latestEp = episodes.sort((a, b) => (b.data.episodeNumber ?? 0) - (a.data.episodeNumber ?? 0))[0];
  return {
    series: s,
    publishedEpisodes: episodes.length,
    latestEpisodeTitle: latestEp?.data.title,
  };
});

// 新着記事: 日付順
const newArticles = [...allArticles]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 9);

// カテゴリ別記事数
const categoryCounts: Record<string, number> = {};
for (const a of allArticles) {
  categoryCounts[a.data.category] = (categoryCounts[a.data.category] ?? 0) + 1;
}

// ランキング
const ranked = allArticles
  .filter(a => a.data.rankingOrder != null)
  .sort((a, b) => a.data.rankingOrder! - b.data.rankingOrder!)
  .slice(0, 10);

// スタッフ
const staff = (await getCollection('staff'))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="KURAGE by 海月舎 ── 骨のない文章が、いちばん深い。">
  <Header />
  <MobileMenu />

  <!-- Hero — 連載カルーセル -->
  <HeroCarousel seriesSlides={seriesData} />

  <KurageIndex />

  <!-- 新着記事 — 浅い層: 透き通ったクラゲ -->
  <section class="z z--new" id="new">
    <div class="kj-icon kj-icon--1 kj-icon--shallow" aria-hidden="true"><JellyfishSvg /></div>
    <div class="kj-icon kj-icon--4 kj-icon--shallow" aria-hidden="true"><JellyfishSvg /></div>
    <SectionHead label="New Articles" title="新着記事" moreHref="/magazine" />
    <div class="new-grid">
      {newArticles.map(a => <ArticleCard article={a} />)}
    </div>
  </section>

  <KurageIndex />

  <!-- カテゴリ — 中層: やや光り始める -->
  <section class="z z--categories" id="categories">
    <div class="kj-icon kj-icon--2 kj-icon--mid" aria-hidden="true"><JellyfishSvg /></div>
    <div class="kj-icon kj-icon--5 kj-icon--mid" aria-hidden="true"><JellyfishSvg /></div>
    <SectionHead label="Categories" title="カテゴリ" />
    <div class="cat-grid">
      {(['essay', 'fiction', 'column'] as CategoryKey[]).map(key => (
        <CategoryCard categoryKey={key} count={categoryCounts[key] ?? 0} />
      ))}
    </div>
  </section>

  <KurageIndex />

  <!-- ランキング — 深層: はっきり発光 -->
  <section class="z z--ranking" id="ranking">
    <div class="kj-icon kj-icon--3 kj-icon--deep" aria-hidden="true"><JellyfishSvg /></div>
    <div class="kj-icon kj-icon--6 kj-icon--deep" aria-hidden="true"><JellyfishSvg /></div>
    <SectionHead label="Monthly Ranking" title="今月の人気記事" moreHref="/magazine" />
    <div class="rank-list">
      {ranked.map((a, i) => <RankItem article={a} rank={i + 1} />)}
    </div>
  </section>

  <KurageIndex />

  <!-- About — 最深部手前: 強く発光 -->
  <AboutSection />

  <KurageIndex />

  <!-- Vessels (Staff) — 最深部: 最も強く発光 -->
  <section class="z z--vessels" id="vessels">
    <div class="kj-icon kj-icon--7 kj-icon--abyss" aria-hidden="true"><JellyfishSvg /></div>
    <SectionHead label="STAFF" title="スタッフ一覧" />
    <div class="vessels-grid">
      {staff.map(m => <StaffCard member={m} />)}
    </div>
  </section>

  <KurageIndex />

  <Footer />
</BaseLayout>
